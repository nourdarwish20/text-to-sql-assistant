# Copy this file to .env to change settings (optional - defaults work out of the box).
# On Streamlit Community Cloud, put the same keys in the app's Secrets instead.

# Which LLM to use: "ollama" (local) or "groq" (hosted).
# If not set: Groq when GROQ_API_KEY is set, otherwise Ollama.
# TEXT2SQL_PROVIDER=ollama

# --- Ollama (local, free) ---
# Any model installed in Ollama (`ollama list`). Bigger = more accurate, slower.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# --- Groq (hosted) --- get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
